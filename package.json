{
  "name": "compass-astro-theme",
  "description": "A free Astro documentation theme for product docs, help centers, and knowledge bases, with Pagefind search, MDX components, and light and dark modes.",
  "type": "module",
  "version": "3.0.0",
  "author": "Andrei Alba",
  "license": "MIT",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "documentation",
    "docs",
    "help-center",
    "knowledge-base",
    "mdx",
    "pagefind",
    "tailwindcss"
  ],
  "homepage": "https://compass.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/compass.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.6",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
