---
import { getCollection } from 'astro:content';
import DocsSidebar from '@/components/layout/DocsSidebar.astro';
import TableOfContents from '@/components/layout/TableOfContents.astro';
import Icon from '@/components/ui/Icon.astro';
import { getPublicDocs, getSidebarGroups, type DocsParent } from '@/lib/docs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  updatedAt?: Date;
  parent: DocsParent;
  headings?: { depth: number; slug: string; text: string }[];
  editUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, type, updatedAt, parent, headings = [], editUrl, structuredData } = Astro.props;
const publicDocs = getPublicDocs(await getCollection('docs'));
const groups = getSidebarGroups(publicDocs, parent.slug);
const currentHref = Astro.url.pathname.replace(/\/+$/, '') || '/';
const hasToc = headings.length > 0;
---

<BaseLayout title={title} description={description} type={type} updatedAt={updatedAt} structuredData={structuredData}>
  {hasToc && (
    <div class="docs-mobile-toc-shell xl:hidden" data-mobile-toc>
      <div class="shell">
        <details class="docs-mobile-toc">
          <summary class="flex cursor-pointer list-none items-center gap-3 py-3 text-sm">
            <span class="shrink-0 font-semibold text-ink">On this page</span>
            <Icon name="chevron-right" class="size-3.5 shrink-0 text-faint" />
            <span class="docs-mobile-toc-current min-w-0" data-mobile-toc-current>
              {headings[0].text}
            </span>
            <Icon name="chevron-down" class="docs-mobile-toc-icon size-4 shrink-0 text-muted" />
          </summary>
          <div class="docs-mobile-toc-panel pb-4">
            <ol class="docs-toc-list">
              {headings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class:list={['docs-toc-link', heading.depth === 3 && 'docs-toc-link-subheading']}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </details>
      </div>
    </div>
  )}

  <div class:list={['shell docs-shell', hasToc && 'has-toc']}>
    <aside class="hidden lg:block">
      <DocsSidebar parent={parent} groups={groups} currentHref={currentHref} />
    </aside>

    <div class="docs-main">
      <slot />
    </div>

    {hasToc && (
      <aside class="hidden xl:block">
        <TableOfContents headings={headings} editUrl={editUrl} />
      </aside>
    )}
  </div>
</BaseLayout>
