---
import { getCollection } from 'astro:content';
import SearchDialog from '@/components/chrome/SearchDialog.astro';
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import SiteHeader from '@/components/chrome/SiteHeader.astro';
import SearchPreviews from '@/components/SearchPreviews.astro';
import { home } from '@/config/home';
import { siteConfig } from '@/config/site';
import { getPublicDocs, getSearchPreviewLookup, getSuggestedSearchArticles } from '@/lib/docs';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  updatedAt?: Date;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  type = 'website',
  updatedAt,
  noindex = false,
  structuredData,
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const socialImage = new URL(siteConfig.socialImage, siteConfig.siteUrl).toString();

const publicDocs = getPublicDocs(await getCollection('docs'));
const searchPreviews = getSearchPreviewLookup(publicDocs);
const searchSuggestions = getSuggestedSearchArticles(publicDocs, {
  limit: 5,
  categories: home.popular.categories,
});

const schema = structuredData ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
};
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" id="site-favicon" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} Updates`}
      href={new URL('/rss.xml', siteConfig.siteUrl).toString()}
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name} documentation`} />
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      (() => {
        const storageKey = 'compass-theme';
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        let stored = null;

        try {
          stored = localStorage.getItem(storageKey);
        } catch {}

        const apply = (isDark) => {
          root.classList.toggle('dark', isDark);
          const favicon = document.getElementById('site-favicon');
          if (favicon) favicon.setAttribute('href', isDark ? '/favicon-dark.svg' : '/favicon-light.svg');
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.setAttribute('aria-pressed', String(isDark));
          });
        };

        apply(stored ? stored === 'dark' : systemDark.matches);

        systemDark.addEventListener('change', (event) => {
          if (!stored) apply(event.matches);
        });

        document.addEventListener('DOMContentLoaded', () => {
          apply(root.classList.contains('dark'));
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.addEventListener('click', () => {
              const isDark = !root.classList.contains('dark');
              stored = isDark ? 'dark' : 'light';
              try {
                localStorage.setItem(storageKey, stored);
              } catch {}
              apply(isDark);
            });
          });
        });
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <SiteHeader />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <SearchPreviews previews={searchPreviews} />
    <SearchDialog suggestions={searchSuggestions} />
  </body>
</html>
