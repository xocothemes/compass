---
import Icon from '@/components/ui/Icon.astro';
import { docsParentCategories } from '@/config/docs';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <section class="hero">
    <div class="shell shell-narrow flex flex-col items-center py-24 text-center md:py-32">
      <p class="hero-pill">
        <span class="hero-pill-dot">
          <Icon name="compass" class="size-3.5" />
        </span>
        Error 404
      </p>
      <h1 class="hero-title mt-6 text-[2.5rem] leading-[1.1] font-bold tracking-[-0.045em] md:text-6xl">
        This page wandered off
      </h1>
      <p class="mt-5 max-w-lg text-[1.05rem] leading-relaxed text-muted">
        The link may be outdated, or the address may have been typed incorrectly. Search the docs or start from one of
        the sections below.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <button type="button" class="button button-primary" data-search-open>
          <Icon name="search" class="size-4" />
          Search the docs
        </button>
        <a href="/" class="button button-secondary">
          Back to home
        </a>
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-2">
        {docsParentCategories.map((parent) => (
          <a href={`/${parent.slug}`} class="popular-chip">
            {parent.name}
            <Icon name="arrow-right" class="size-3.5" />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
