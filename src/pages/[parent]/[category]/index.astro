---
import { getCollection } from 'astro:content';
import PaginatedArticleList from '@/components/PaginatedArticleList.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import { docsCategories } from '@/config/docs';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { docsParentMap, getDocHref, getOrderedDocsForCategory, getPublicDocs } from '@/lib/docs';

export function getStaticPaths() {
  return docsCategories.map((category) => ({
    params: { parent: category.parent, category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const parent = docsParentMap[category.parent];
const categoryDocs = getOrderedDocsForCategory(getPublicDocs(await getCollection('docs')), category.slug);
---

<DocsLayout title={`${category.name} - ${parent.name}`} description={category.description} parent={parent}>
  <Breadcrumbs items={[{ label: parent.name, href: `/${parent.slug}` }, { label: category.name }]} />

  <header class="mt-6 border-b border-line pb-8">
    <span class="icon-tile size-12">
      <Icon name={category.icon} class="size-[1.35rem]" />
    </span>
    <h1 class="mt-5 text-[2.15rem] leading-[1.15] font-bold tracking-[-0.035em] md:text-[2.6rem]">{category.name}</h1>
    <p class="mt-4 max-w-2xl text-[1.075rem] leading-relaxed text-muted">{category.description}</p>
    <p class="docs-meta mt-5">
      <span class="docs-meta-item">
        <Icon name="file-text" class="size-[0.9rem]" />
        {`${categoryDocs.length} ${categoryDocs.length === 1 ? 'article' : 'articles'}`}
      </span>
    </p>
  </header>

  {categoryDocs.length === 0 ? (
    <div class="panel mt-8 px-6 py-14 text-center text-muted">
      No articles yet. Add MDX files in <code class="font-mono text-sm text-ink">src/content/docs/{category.slug}</code>{' '}
      to populate this section.
    </div>
  ) : (
    <div class="mt-8">
      <PaginatedArticleList
        items={categoryDocs.map((doc) => ({
          title: doc.data.title,
          description: doc.data.description,
          href: getDocHref(doc),
        }))}
      />
    </div>
  )}
</DocsLayout>
