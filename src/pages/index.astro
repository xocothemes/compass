---
import { getCollection } from 'astro:content';
import CategoryCard from '@/components/home/CategoryCard.astro';
import CategorySection from '@/components/home/CategorySection.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import RecentUpdates from '@/components/home/RecentUpdates.astro';
import SupportBand from '@/components/home/SupportBand.astro';
import { docsParentCategories } from '@/config/docs';
import { home } from '@/config/home';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getCategoriesForParent,
  getCategoryHref,
  getCategoryName,
  getDocHref,
  getPublicDocs,
  getRecentDocs,
  getSuggestedSearchArticles,
} from '@/lib/docs';

const publicDocs = getPublicDocs(await getCollection('docs'));
const suggestions = getSuggestedSearchArticles(publicDocs, {
  limit: home.popular.limit,
  categories: home.popular.categories,
});
const recent = getRecentDocs(publicDocs, home.recent.limit).map((doc) => ({
  title: doc.data.title,
  href: getDocHref(doc),
  category: getCategoryName(doc.data.category),
  updatedAt: doc.data.updatedAt!,
}));
---

<BaseLayout>
  <HomeHero suggestions={suggestions} />

  <div class="pt-6">
    {docsParentCategories.map((parent) => (
      <CategorySection slug={parent.slug} title={parent.name} description={parent.description}>
        {getCategoriesForParent(parent.slug).map((category) => (
          <CategoryCard
            title={category.name}
            description={category.description}
            count={publicDocs.filter((doc) => doc.data.category === category.slug).length}
            href={getCategoryHref(category.slug)}
            icon={category.icon}
          />
        ))}
      </CategorySection>
    ))}
  </div>

  <RecentUpdates items={recent} />
  <SupportBand />
</BaseLayout>
