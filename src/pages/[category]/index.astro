---
import { getCollection } from 'astro:content';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import { docsParentCategories } from '@/config/docs';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getPublicDocs, getSidebarGroups } from '@/lib/docs';

export function getStaticPaths() {
  return docsParentCategories.map((parent) => ({
    params: { category: parent.slug },
    props: { parent },
  }));
}

const { parent } = Astro.props;
const groups = getSidebarGroups(getPublicDocs(await getCollection('docs')), parent.slug);
const previewLimit = 5;
---

<DocsLayout title={parent.name} description={parent.description} parent={parent}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: parent.name }]} />

  <header class="mt-6 border-b border-line pb-8">
    <h1 class="text-[2.15rem] leading-[1.15] font-bold tracking-[-0.035em] md:text-[2.6rem]">{parent.name}</h1>
    <p class="mt-4 max-w-2xl text-[1.075rem] leading-relaxed text-muted">{parent.description}</p>
  </header>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {groups.map((group) => (
      <section class="panel flex flex-col p-6">
        <a href={group.href} class="group flex items-center gap-3">
          <span class="icon-tile size-10">
            <Icon name={group.icon} class="size-[1.1rem]" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-lg font-semibold tracking-[-0.02em] text-ink group-hover:text-accent-ink">
              {group.name}
            </span>
            <span class="block text-xs text-muted">
              {group.articles.length} {group.articles.length === 1 ? 'article' : 'articles'}
            </span>
          </span>
        </a>
        <ul class="mt-5 flex-1 space-y-1 border-t border-line pt-4">
          {group.articles.slice(0, previewLimit).map((article) => (
            <li>
              <a
                href={article.href}
                class="group flex items-center gap-2.5 rounded-lg py-1.5 text-sm text-body transition-colors hover:text-ink"
              >
                <Icon name="file-text" class="size-4 text-faint transition-colors group-hover:text-accent" />
                {article.title}
              </a>
            </li>
          ))}
        </ul>
        {group.articles.length > previewLimit && (
          <a
            href={group.href}
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink hover:gap-2.5"
          >
            View all {group.articles.length}
            <Icon name="arrow-right" class="size-4" />
          </a>
        )}
      </section>
    ))}
  </div>
</DocsLayout>
