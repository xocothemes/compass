---
import Icon from '@/components/ui/Icon.astro';
import type { SearchSuggestion } from '@/lib/docs';

interface Props {
  suggestions: SearchSuggestion[];
}

const { suggestions } = Astro.props;
---

<dialog class="search-dialog" aria-label="Search the docs" data-search-dialog>
  <div
    class="search-dialog-panel"
    role="search"
    data-docs-search
    data-search-mode="dialog"
    data-search-empty="No articles match that search."
    data-search-error="Search is available after running npm run build and npm run preview."
    data-search-suggestions={JSON.stringify(suggestions)}
  >
    <div class="search-dialog-field">
      <Icon name="search" class="size-[1.15rem] text-muted" />
      <label for="search-dialog-input" class="sr-only">
        Search the docs
      </label>
      <p id="search-dialog-hint" class="sr-only">
        Type to search the documentation. Use the arrow keys to choose a result and Enter to open it.
      </p>
      <p id="search-dialog-status" class="sr-only" aria-live="polite" data-search-status></p>
      <input
        id="search-dialog-input"
        type="search"
        role="combobox"
        class="search-input h-full text-[0.95rem]"
        placeholder="Search guides, components, and references..."
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-controls="search-dialog-results"
        aria-describedby="search-dialog-hint search-dialog-status"
        aria-expanded="false"
        aria-haspopup="listbox"
        data-search-input
      />
      <button type="button" class="kbd !h-6 cursor-pointer !px-1.5" aria-label="Close search" data-search-close>
        Esc
      </button>
    </div>
    <div
      id="search-dialog-results"
      class="search-results hidden"
      role="listbox"
      aria-label="Search results"
      aria-hidden="true"
      data-search-results
    ></div>
    <div class="search-dialog-footer hidden sm:flex" aria-hidden="true">
      <span class="inline-flex items-center gap-1.5">
        <kbd class="kbd">↑</kbd>
        <kbd class="kbd">↓</kbd> to navigate
      </span>
      <span class="inline-flex items-center gap-1.5">
        <kbd class="kbd">↵</kbd> to open
      </span>
      <span class="inline-flex items-center gap-1.5">
        <kbd class="kbd">esc</kbd> to close
      </span>
      <span class="ml-auto">Search by Pagefind</span>
    </div>
  </div>
</dialog>

<script>
  import '../../scripts/docs-search';
</script>
