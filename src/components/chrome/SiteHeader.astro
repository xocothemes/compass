---
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { docsParentCategories } from '@/config/docs';
import { siteConfig } from '@/config/site';
import { getCategoriesForParent, getCategoryHref } from '@/lib/docs';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const actionIcon = siteConfig.action.href.includes('github.com') ? 'social-github' : 'arrow-up-right';
const actionIsExternal = /^https?:\/\//.test(siteConfig.action.href);
---

<header class="site-header">
  <div class="shell flex h-full items-center gap-4 lg:gap-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5 rounded-lg" aria-label={`${siteConfig.name} home`}>
      <Logomark class="size-7" />
      <span class="text-[1.05rem] font-bold tracking-[-0.03em] text-ink">{siteConfig.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {docsParentCategories.map((parent) => {
        const href = `/${parent.slug}`;
        return (
          <a href={href} class="site-nav-link" aria-current={isActive(href) ? 'page' : undefined}>
            {parent.name}
          </a>
        );
      })}
    </nav>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      <button type="button" class="search-trigger hidden w-56 md:inline-flex xl:w-64" data-search-open>
        <Icon name="search" class="size-4" />
        <span class="flex-1 text-left">Search docs...</span>
        <span class="flex gap-1">
          <kbd class="kbd" data-shortcut-mod>
            Ctrl
          </kbd>
          <kbd class="kbd">K</kbd>
        </span>
      </button>
      <button type="button" class="icon-button md:hidden" aria-label="Search docs" data-search-open>
        <Icon name="search" class="size-[1.15rem]" />
      </button>

      <button type="button" class="icon-button theme-toggle" aria-label="Toggle dark mode" data-theme-toggle>
        <Icon name="moon" class="icon-moon size-[1.15rem]" />
        <Icon name="sun" class="icon-sun size-[1.15rem]" />
      </button>

      <a
        href={siteConfig.action.href}
        class="button button-secondary hidden !min-h-9 !rounded-[0.7rem] !px-3 sm:inline-flex"
        target={actionIsExternal ? '_blank' : undefined}
        rel={actionIsExternal ? 'noreferrer' : undefined}
      >
        <Icon name={actionIcon} class="size-4" />
        {siteConfig.action.label}
      </a>

      <button
        type="button"
        class="icon-button lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <Icon name="menu" class="menu-open size-5" />
        <Icon name="x" class="menu-close hidden size-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden" hidden data-menu>
    <nav class="shell grid gap-6 py-6 sm:grid-cols-2" aria-label="Mobile">
      {docsParentCategories.map((parent) => (
        <div>
          <a href={`/${parent.slug}`} class="eyebrow block px-3 hover:text-ink">
            {parent.name}
          </a>
          <ul class="mt-2 space-y-0.5">
            {getCategoriesForParent(parent.slug).map((category) => {
              const href = getCategoryHref(category.slug);
              return (
                <li>
                  <a href={href} class="mobile-menu-link" aria-current={isActive(href) ? 'page' : undefined}>
                    <span class="icon-tile size-8 !rounded-lg">
                      <Icon name={category.icon} class="size-4" />
                    </span>
                    {category.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
      <a
        href={siteConfig.action.href}
        class="button button-secondary sm:col-span-2"
        target={actionIsExternal ? '_blank' : undefined}
        rel={actionIsExternal ? 'noreferrer' : undefined}
      >
        <Icon name={actionIcon} class="size-4" />
        {siteConfig.action.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const setMenuOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setMenuOpen(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
    document.querySelectorAll('[data-shortcut-mod]').forEach((key) => (key.textContent = '⌘'));
  }
</script>
