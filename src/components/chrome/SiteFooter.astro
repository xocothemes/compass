---
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { docsParentCategories } from '@/config/docs';
import { footerLinks, siteConfig } from '@/config/site';
import { getCategoriesForParent, getCategoryHref } from '@/lib/docs';

const socialIcon = (label: string) => {
  const key = label.toLowerCase();
  if (key === 'github') return 'social-github';
  if (key === 'rss') return 'social-rss';
  return 'link';
};
---

<footer class="site-footer">
  <div class="shell flex flex-col gap-10 py-14 md:flex-row md:gap-16">
    <div class="max-w-xs">
      <a href="/" class="inline-flex items-center gap-2.5">
        <Logomark class="size-7" />
        <span class="text-[1.05rem] font-bold tracking-[-0.03em] text-ink">{siteConfig.name}</span>
      </a>
      <p class="mt-4 text-sm leading-6 text-muted">{siteConfig.footerText}</p>
      <div class="mt-5 flex gap-1">
        {siteConfig.socials.map((social) => (
          <a
            href={social.href}
            class="icon-button"
            aria-label={social.label}
            title={social.label}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
          >
            <Icon name={socialIcon(social.label)} class="size-[1.1rem]" />
          </a>
        ))}
      </div>
    </div>

    <div class="grid flex-1 grid-cols-2 gap-8 sm:grid-cols-3">
      {docsParentCategories.map((parent) => (
        <div>
          <a href={`/${parent.slug}`} class="block text-sm font-semibold text-ink hover:text-accent-ink">
            {parent.name}
          </a>
          <ul class="mt-4 space-y-2.5">
            {getCategoriesForParent(parent.slug).map((category) => (
              <li>
                <a href={getCategoryHref(category.slug)} class="footer-link">
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <p class="text-sm font-semibold text-ink">Resources</p>
        <ul class="mt-4 space-y-2.5">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="shell flex flex-col gap-2 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        &copy; {new Date().getFullYear()} {siteConfig.name}. Released under the MIT License.
      </p>
      <p>
        Built with{' '}
        <a href="https://astro.build" class="footer-link" target="_blank" rel="noreferrer">
          Astro
        </a>
      </p>
    </div>
  </div>
</footer>
