---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  editUrl?: string;
}

const { headings, editUrl } = Astro.props;
---

<nav class="docs-rail" aria-label="Table of contents">
  <p class="docs-toc-title">
    <Icon name="list-checks" class="size-4 text-muted" />
    On this page
  </p>
  <ol class="docs-toc-list">
    {headings.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          data-toc-link={heading.slug}
          class:list={['docs-toc-link', heading.depth === 3 && 'docs-toc-link-subheading']}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ol>
  <div class="mt-6 flex flex-col gap-3 border-t border-line pt-5">
    {editUrl && (
      <a href={editUrl} class="docs-toc-footer-link" target="_blank" rel="noreferrer">
        <Icon name="pencil-line" class="size-[0.9rem]" />
        Edit this page
      </a>
    )}
    <a href="#content" class="docs-toc-footer-link">
      <Icon name="arrow-up" class="size-[0.9rem]" />
      Back to top
    </a>
  </div>
</nav>
