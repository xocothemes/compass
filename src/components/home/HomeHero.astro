---
import Icon from '@/components/ui/Icon.astro';
import { home } from '@/config/home';
import type { SearchSuggestion } from '@/lib/docs';

interface Props {
  suggestions: SearchSuggestion[];
}

const { suggestions } = Astro.props;
const { hero, popular } = home;
---

<section class="hero">
  <div class="shell shell-narrow flex flex-col items-center pt-20 pb-20 text-center md:pt-28 md:pb-24">
    <p class="hero-pill rise">
      <span class="hero-pill-dot">
        <Icon name="compass" class="size-3.5" />
      </span>
      {hero.eyebrow}
    </p>
    <h1
      class="hero-title rise mt-6 max-w-3xl text-[2.75rem] leading-[1.05] font-bold tracking-[-0.04em] text-balance md:text-[4.25rem]"
      style="--rise-delay: 60ms"
    >
      {hero.title}
    </h1>
    <p
      class="rise mt-5 max-w-xl text-[1.075rem] leading-relaxed text-pretty text-muted md:text-lg"
      style="--rise-delay: 120ms"
    >
      {hero.description}
    </p>

    <div
      class="hero-search rise relative mt-9 w-full max-w-[38rem]"
      style="--rise-delay: 180ms"
      role="search"
      data-docs-search
      data-search-empty="No articles match that search."
      data-search-error="Search is available after running npm run build and npm run preview."
      data-search-suggestions={JSON.stringify(suggestions)}
    >
      <label class="sr-only" for="hero-search-input">
        Search the docs
      </label>
      <p id="hero-search-hint" class="sr-only">
        Type to search the documentation. Use the arrow keys to choose a result and Enter to open it.
      </p>
      <p id="hero-search-status" class="sr-only" data-search-status aria-live="polite"></p>
      <div class="search-field h-14 gap-3 px-5 md:h-16">
        <Icon name="search" class="size-5 text-faint" />
        <input
          id="hero-search-input"
          type="search"
          role="combobox"
          class="search-input text-base md:text-[1.05rem]"
          placeholder={hero.placeholder}
          autocomplete="off"
          spellcheck="false"
          aria-autocomplete="list"
          aria-controls="hero-search-results"
          aria-describedby="hero-search-hint hero-search-status"
          aria-expanded="false"
          aria-haspopup="listbox"
          data-search-input
        />
        <span class="hidden gap-1 sm:flex" aria-hidden="true">
          <kbd class="kbd" data-shortcut-mod>
            Ctrl
          </kbd>
          <kbd class="kbd">K</kbd>
        </span>
      </div>
      <div
        id="hero-search-results"
        class="search-results hidden"
        role="listbox"
        aria-label="Search results"
        aria-hidden="true"
        data-search-results
      ></div>
    </div>

    {suggestions.length > 0 && (
      <div class="hero-popular rise mt-6 flex flex-wrap items-center justify-center gap-2" style="--rise-delay: 240ms">
        <span class="mr-1 text-sm text-muted">{popular.label}:</span>
        {suggestions.map((suggestion) => (
          <a href={suggestion.url} class="popular-chip">
            {suggestion.title}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  import '../../scripts/docs-search';
</script>
