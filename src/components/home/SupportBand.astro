---
import Icon from '@/components/ui/Icon.astro';
import { home } from '@/config/home';

const { support } = home;
---

<section class="shell shell-narrow pt-10 pb-20 md:pt-12 md:pb-24">
  <div class="support-band flex flex-col gap-8 p-8 md:flex-row md:items-center md:justify-between md:p-12">
    <div class="flex items-start gap-5">
      <span class="icon-tile hidden size-12 sm:inline-grid">
        <Icon name="life-buoy" class="size-[1.35rem]" />
      </span>
      <div>
        <h2 class="text-2xl font-bold tracking-[-0.03em]">{support.title}</h2>
        <p class="mt-2 max-w-lg text-[0.95rem] leading-6 text-muted">{support.description}</p>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      {support.actions.map((action) => {
        const external = /^https?:\/\//.test(action.href);
        return (
          <a
            href={action.href}
            class:list={['button', action.variant === 'primary' ? 'button-primary' : 'button-secondary']}
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer' : undefined}
          >
            {action.label}
            <Icon name={external ? 'arrow-up-right' : 'arrow-right'} class="size-4" />
          </a>
        );
      })}
    </div>
  </div>
</section>
