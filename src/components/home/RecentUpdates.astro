---
import Icon from '@/components/ui/Icon.astro';
import { home } from '@/config/home';
import { formatDate } from '@/lib/docs';

interface Props {
  items: { title: string; href: string; category: string; updatedAt: Date }[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="shell shell-narrow py-10 md:py-12">
    <div class="mb-7">
      <h2 class="text-2xl font-bold tracking-[-0.03em] md:text-[1.75rem]">{home.recent.title}</h2>
      <p class="mt-2 text-[0.95rem] leading-6 text-muted">{home.recent.description}</p>
    </div>
    <div class="panel overflow-hidden">
      {items.map((item) => (
        <a href={item.href} class="row-link group">
          <span class="icon-tile hidden size-9 !rounded-lg sm:inline-grid">
            <Icon name="file-text" class="size-4" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-semibold text-ink transition-colors group-hover:text-accent-ink">
              {item.title}
            </span>
            <span class="mt-0.5 block text-xs text-muted">{item.category}</span>
          </span>
          <time class="hidden shrink-0 text-sm text-muted sm:block" datetime={item.updatedAt.toISOString()}>
            {formatDate(item.updatedAt)}
          </time>
          <Icon name="arrow-right" class="row-link-arrow size-4" />
        </a>
      ))}
    </div>
  </section>
)}
