---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  count: number;
  href: string;
  icon: string;
}

const { title, description, count, href, icon } = Astro.props;
---

<a href={href} class="category-card group">
  <div class="flex items-start justify-between">
    <span class="icon-tile size-11">
      <Icon name={icon} class="size-5" />
    </span>
    <Icon name="arrow-up-right" class="category-card-arrow size-5" />
  </div>
  <h3 class="mt-6 text-lg font-semibold tracking-[-0.02em]">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-muted">{description}</p>
  <p class="mt-6 inline-flex items-center gap-1.5 text-xs font-medium text-muted">
    <Icon name="file-text" class="size-3.5" />
    {`${count} ${count === 1 ? 'article' : 'articles'}`}
  </p>
</a>
