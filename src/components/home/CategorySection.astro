---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  slug: string;
  title: string;
  description?: string;
}

const { slug, title, description } = Astro.props;
---

<section id={slug} class="shell shell-narrow py-10 md:py-12">
  <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-[-0.03em] md:text-[1.75rem]">{title}</h2>
      {description && <p class="mt-2 max-w-xl text-[0.95rem] leading-6 text-muted">{description}</p>}
    </div>
    <a
      href={`/${slug}`}
      class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-accent-ink transition-[gap] hover:gap-2.5"
    >
      Browse all
      <Icon name="arrow-right" class="size-4" />
    </a>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    <slot />
  </div>
</section>
