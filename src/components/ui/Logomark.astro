---
interface Props {
  class?: string;
}

const { class: className = 'size-7' } = Astro.props;
const gradientId = `logomark-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7c6fff"></stop>
      <stop offset="1" stop-color="#4332d6"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${gradientId})`}></rect>
  <rect x="0.5" y="0.5" width="31" height="31" rx="8.5" stroke="#fff" stroke-opacity="0.18"></rect>
  <g transform="rotate(45 16 16)">
    <path d="M16 6.25 19.25 16h-6.5L16 6.25Z" fill="#fff"></path>
    <path d="M12.75 16h6.5L16 25.75 12.75 16Z" fill="#fff" fill-opacity="0.45"></path>
  </g>
  <circle cx="16" cy="16" r="1.6" fill="#4332d6"></circle>
</svg>
