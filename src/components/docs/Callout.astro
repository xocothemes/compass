---
import Icon from '../ui/Icon.astro';

interface Props {
  tone?: 'info' | 'success' | 'warning' | 'danger';
  title?: string;
}

const { tone = 'info', title } = Astro.props;

const icons = {
  info: 'info',
  success: 'circle-check',
  warning: 'triangle-alert',
  danger: 'octagon-alert',
} as const;
---

<aside class:list={['docs-callout not-prose my-6 px-5 py-4', `docs-callout-${tone}`]}>
  <div class="flex items-start gap-3">
    <Icon name={icons[tone]} class="docs-callout-icon mt-0.5 size-5" />
    <div class="min-w-0">
      {title && <p class="docs-callout-title mb-1 text-sm font-semibold">{title}</p>}
      <div class="text-[0.9rem] leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</aside>
