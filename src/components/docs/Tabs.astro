---
interface Props {
  labels: string[];
}

const { labels = [] } = Astro.props;
const tabId = `tabs-${Math.random().toString(36).slice(2, 10)}`;
const panels = await Promise.all(labels.map((_, index) => Astro.slots.render(`panel-${index + 1}`)));
---

<div class="docs-tabs not-prose my-8" data-tabs-root={tabId}>
  <div class="docs-tabs-list flex flex-wrap gap-6" role="tablist" aria-label="Tabs">
    {labels.map((label, index) => (
      <button
        type="button"
        id={`${tabId}-tab-${index}`}
        class:list={['docs-tab pb-3 text-sm font-semibold transition', index === 0 && 'is-active']}
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`${tabId}-panel-${index}`}
        tabindex={index === 0 ? '0' : '-1'}
        data-tab-trigger

        data-tab-target={`${tabId}-panel-${index}`}
      >
        {label}
      </button>
    ))}
  </div>

  {panels.map((panel, index) => (
    <section
      class="docs-tab-panel pt-6"
      role="tabpanel"
      id={`${tabId}-panel-${index}`}
      aria-labelledby={`${tabId}-tab-${index}`}
      tabindex={0}
      data-tab-panel
      hidden={index !== 0}
      set:html={panel}
    />
  ))}
</div>

<script>
  import '../../scripts/tabs';
</script>
